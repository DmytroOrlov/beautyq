{
  "permissions": {
    "allow": [
      "Bash(sbt *)",
      "Bash(git status --short)",
      "Bash(git diff --check)",
      "Bash(echo \"exit=$?\")"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)"
    ],
    "ask": [
      "Bash(git checkout *)"
    ]
  }
}
