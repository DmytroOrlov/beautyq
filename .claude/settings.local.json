{
  "permissions": {
    "allow": [
      "Bash(sbt *)",
      "Bash(git status --short)",
      "Bash(git diff --check)",
      "Bash(echo \"exit=$?\")",
      "Bash(echo \"--- check exit: $? ---\")",
      "Bash(git status *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)"
    ],
    "ask": []
  }
}
